# Local demo defaults — copy to .env and change if you like.
# Never commit a real .env with production secrets.

POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ecommerce
POSTGRES_PORT=5432

AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=changeme
AIRFLOW_PORT=8080

# Generate a unique Fernet key for anything beyond local learning:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=<generate-with-the-command-above>
AIRFLOW_WEBSERVER_SECRET_KEY=changeme

METABASE_PORT=3000
# Created by scripts/setup_metabase.py on a fresh volume
METABASE_EMAIL=admin@example.com
METABASE_PASSWORD=changeme
